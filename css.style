*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Segoe UI',sans-serif;
}

body{
background:url('background.jpg');
background-size:cover;
background-position:center;
background-attachment:fixed;
color:white;
min-height:100vh;
}

.background-overlay{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,.55);
z-index:-1;
}

/* LOGIN */

.login-page{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
gap:25px;
}

.logo{
width:100px;
height:100px;
border-radius:20px;
background:linear-gradient(135deg,#7c3aed,#c026d3);
display:flex;
justify-content:center;
align-items:center;
font-size:35px;
font-weight:bold;
}

.logo-area{
text-align:center;
}

.logo-area h1{
margin-top:15px;
font-size:40px;
}

.logo-area p{
opacity:.8;
}

.login-card{
width:400px;
padding:30px;
background:rgba(255,255,255,.08);
backdrop-filter:blur(15px);
border:1px solid rgba(255,255,255,.1);
border-radius:20px;
}

.login-card h2{
text-align:center;
margin-bottom:20px;
}

.input-group{
display:flex;
align-items:center;
background:#111827;
margin-bottom:15px;
padding:14px;
border-radius:10px;
}

.input-group i{
margin-right:10px;
color:#a855f7;
}

.input-group input{
background:none;
border:none;
outline:none;
color:white;
width:100%;
}

button{
width:100%;
padding:14px;
border:none;
border-radius:10px;
cursor:pointer;
font-weight:bold;
font-size:16px;
background:linear-gradient(135deg,#7c3aed,#c026d3);
color:white;
transition:.3s;
}

button:hover{
transform:translateY(-2px);
}

/* DASHBOARD */

.dashboard{
display:flex;
min-height:100vh;
background:#050816;
}

.sidebar{
width:260px;
background:#090d1f;
padding:25px;
}

.sidebar-logo{
display:flex;
align-items:center;
gap:10px;
margin-bottom:40px;
}

.logo-small{
width:50px;
height:50px;
background:#7c3aed;
border-radius:12px;
display:flex;
align-items:center;
justify-content:center;
font-weight:bold;
}

.sidebar ul{
list-style:none;
}

.sidebar li{
padding:15px;
margin-bottom:10px;
border-radius:12px;
cursor:pointer;
transition:.3s;
}

.sidebar li:hover,
.sidebar li.active{
background:#7c3aed;
}

.sidebar i{
margin-right:10px;
}

.main-content{
flex:1;
padding:30px;
}

.topbar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:30px;
}

.topbar input{
width:350px;
padding:12px;
background:#111827;
border:none;
border-radius:10px;
color:white;
}

.admin-box{
background:#7c3aed;
padding:12px 20px;
border-radius:10px;
}

.cards{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
margin-top:20px;
}

.card{
background:#111827;
padding:25px;
border-radius:20px;
border:1px solid rgba(255,255,255,.05);
}

.card h3{
opacity:.7;
margin-bottom:10px;
}

.card h2{
font-size:35px;
}

.content-box{
display:grid;
grid-template-columns:2fr 1fr;
gap:20px;
margin-top:30px;
}

.chart,
.activity{
background:#111827;
padding:25px;
border-radius:20px;
}

.fake-chart{
height:300px;
margin-top:20px;
border-radius:20px;
background:linear-gradient(
180deg,
#7c3aed,
transparent
);
}

.activity ul{
margin-top:20px;
}

.activity li{
padding:15px;
border-bottom:1px solid rgba(255,255,255,.08);
list-style:none;
}

@media(max-width:1000px){

.cards{
grid-template-columns:1fr 1fr;
}

.content-box{
grid-template-columns:1fr;
}

}

@media(max-width:768px){

.sidebar{
display:none;
}

.cards{
grid-template-columns:1fr;
}

.topbar{
flex-direction:column;
gap:15px;
}

.topbar input{
width:100%;
}

.login-card{
width:95%;
}

}
